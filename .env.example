# --- Data sources (read live from the local filesystem) ---

# Root of the sephora-project-docs repo (Layer-2 SDLC state).
# ~ expands to your home folder — set this to wherever YOU cloned the repo.
SEPHORA_PROJECT_DOCS=~/sourcecode/Sephora/sephora-project-docs

# Directory holding the seph-sdlc-coach stage coaching cards (stage-N-*.md, concepts.md, ...).
COACH_STAGES_DIR=~/.claude/skills/seph-sdlc-coach/stages

# Year to scan under sephora-project-docs (the repo is organized as <YEAR>/<initiative>).
SDLC_YEAR=2026

# --- /seph-sdlc execution (the chat gateway) ---

# Workspace root the /seph-sdlc skill expects (target repos are cloned under here).
SEPHORA_WORKSPACE_ROOT=~/workspace

# Working directory the Claude engine runs in when driving /seph-sdlc.
# Defaults to SEPHORA_PROJECT_DOCS if unset.
# EXEC_CWD=~/sourcecode/Sephora/sephora-project-docs

# Plugin root so /seph-sdlc + its sephora-* agents resolve. Usually auto-discovered from ~/.claude.
# CLAUDE_PLUGIN_ROOT=~/.claude/plugins/cache/sephora-platform/sephora-sdlc/0.4.0

# How the chat gateway talks to the Claude engine:
#   "cli" (default) — spawns the real `claude` binary; loads your ENABLED plugins
#          natively (sephora-mcp + sephora-sdlc), so /seph-sdlc is available.
#   "sdk" — @anthropic-ai/claude-agent-sdk; does NOT auto-load enabled plugins
#          (sephora-sdlc won't load), so /seph-sdlc is unavailable. Good for status/list only.
CHAT_BACKEND=cli

# Path to the claude binary (used only when CHAT_BACKEND=cli).
CLAUDE_BIN=claude

# Optional: only needed if you want API-key auth instead of the machine's Claude Code login.
# ANTHROPIC_API_KEY=

# --- Dev Plan board (live Jira proxy) ---

# Base URL of the internal Jira the board proxies (read-only). Defaults to the
# jira.base in server/devplan.config.json.
# JIRA_BASE=https://jira.sephora.com

# Path to the board's config file (sprints, systems, colors, jira field IDs).
# Defaults to server/devplan.config.json. No secrets live in this file — the
# Jira Personal Access Token stays in the browser (localStorage), never here.
# DEVPLAN_CONFIG=~/sourcecode/Sephora/sdlc-visualizer/server/devplan.config.json

# --- Server ---
PORT=4317
