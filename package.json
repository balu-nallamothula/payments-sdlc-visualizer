{
  "name": "sdlc-visualizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visualize and drive the Sephora Agentic SDLC (/seph-sdlc) pipeline from a web UI.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:web",
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=server",
    "spike": "node server/scripts/spike-chat.mjs"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
